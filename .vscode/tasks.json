{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Jogo (gcc)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                // Aponta para o seu arquivo .c na pasta raiz do workspace
                "${workspaceFolder}/jogo.c",
                "-o",
                // Define a saida para a pasta 'output'
                "${workspaceFolder}/output/jogo.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}